  },
  {
   "name": "Markdown source keeps formatting",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "## Walk\n\n**Sunshine**",
