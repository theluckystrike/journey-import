{
 "slug": "journey-import",
 "module": "products/journey-import/src/importer.ts",
 "function": "planImport",
 "cases": [
  {
   "name": "Public Journey fixture has two notes and one photo",
   "args": [
    "journey-fixture.zip",
    {},
    [],
    false
   ],
   "expected": {
    "paths": [
     "Journey/2021-06-27 1609.md",
     "Journey/2021-07-01 1200.md"
    ],
    "attachmentCount": 1
   }
  },
  {
   "name": "Vienna entry has a dated name and summer offset",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": []
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "paths": [
     "Journey/2021-07-01 1200.md"
    ],
    "properties": [
     {
      "date": "2021-07-01T12:00:00+02:00",
      "timezone": "Europe/Vienna"
     }
    ]
   }
  },
  {
   "name": "Bold and italic HTML become Markdown",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p><strong>bold </strong><em>italic </em></p>",
      "type": "html",
      "photos": []
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "bodies": [
     "**bold** *italic*"
    ]
   }
  },
  {
   "name": "Photo is copied and embedded",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [
       "photo-5bkOJACgIzl36wsU.jpg"
      ]
     },
     "photo-5bkOJACgIzl36wsU.jpg": "photo"
    },
    {},
    [],
    false
   ],
   "expected": {
    "attachments": [
     "Journey/attachments/photo-5bkOJACgIzl36wsU.jpg"
    ],
    "bodyIncludes": [
     "![[Journey/attachments/photo-5bkOJACgIzl36wsU.jpg]]"
    ]
   }
  },
  {
   "name": "Valid location keeps coordinates and address",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [],
      "lat": 51.502,
      "lon": -0.14,
      "address": "1 Constitution Hill"
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "properties": [
     {
      "location": [
       51.502,
       -0.14
      ],
      "address": "1 Constitution Hill"
     }
    ]
   }
  },
  {
   "name": "Journey sentinel location is omitted",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [],
      "lat": 1.7976931348623157e+308,
      "lon": 1.7976931348623157e+308,
      "address": "unknown"
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "absentProperties": [
     "location",
     "address"
    ]
   }
  },
  {
   "name": "Weather description and temperature are kept",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [],
      "weather": {
       "degree_c": 27.2,
       "description": "Scattered Clouds"
      }
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "properties": [
     {
      "weather": "Scattered Clouds, 27.2 °C"
     }
    ]
   }
  },
  {
   "name": "Same minute entries get numbered suffixes",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": []
     },
     "b.json": {
      "id": "entry-b",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": []
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "paths": [
     "Journey/2021-07-01 1200.md",
     "Journey/2021-07-01 1200 (2).md"
    ]
   }
  },
  {
   "name": "ZIP without Journey entries has no output",
   "args": [
    {
     "readme.txt": "text",
     "settings.json": {
      "key": "value"
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "paths": [],
    "attachmentCount": 0
   }
  },
  {
   "name": "Existing note receives a collision suffix",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": []
     }
    },
    {},
    [
     "Journey/2021-07-01 1200.md"
    ],
    false
   ],
   "expected": {
    "paths": [
     "Journey/2021-07-01 1200 (2).md"
    ]
   }
  },
  {
   "name": "Case variants receive a collision suffix",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": []
     }
    },
    {},
    [
     "journey/2021-07-01 1200.MD"
    ],
    false
   ],
   "expected": {
    "paths": [
     "Journey/2021-07-01 1200 (2).md"
    ]
   }
  },
  {
   "name": "Nested archive photo path resolves by basename",
   "args": [
    {
     "backup/a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [
       "photo.jpg"
      ]
     },
     "backup/photos/photo.jpg": "bytes"
    },
    {},
    [],
    false
   ],
   "expected": {
    "attachments": [
     "Journey/attachments/photo.jpg"
    ]
   }
  },
  {
   "name": "Missing photo is reported",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [
       "missing.jpg"
      ]
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "attachmentCount": 0,
    "warnings": [
     "entry-a: missing or ambiguous photo missing.jpg."
    ]
   }
  },
  {
   "name": "Ambiguous photo is reported",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [
       "photo.jpg"
      ]
     },
     "one/photo.jpg": "a",
     "two/photo.jpg": "b"
    },
    {},
    [],
    false
   ],
   "expected": {
    "attachmentCount": 0,
    "warnings": [
     "entry-a: missing or ambiguous photo photo.jpg."
    ]
   }
  },
  {
   "name": "Shared photo is copied once",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [
       "photo.jpg"
      ]
     },
     "b.json": {
      "id": "entry-b",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [
       "photo.jpg"
      ]
     },
     "photo.jpg": "a"
    },
    {},
    [],
    false
   ],
   "expected": {
    "attachmentCount": 1
   }
  },
  {
   "name": "Existing photo receives a suffix",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": [
       "photo.jpg"
      ]
     },
     "photo.jpg": "a"
