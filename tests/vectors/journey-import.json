  {
   "name": "Free import ignores saved Pro options",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>First entry</p>",
      "type": "html",
      "photos": []
     }
    },
    {
     "merge": true,
