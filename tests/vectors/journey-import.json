   }
  },
  {
   "name": "HTML script and remote image are removed",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "<p>Walk</p><script>bad()</script><img src=\"https://example.invalid/a.jpg\">",
      "type": "html",
      "photos": []
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "bodies": [
     "Walk"
    ]
   }
  },
  {
   "name": "Markdown image is removed",
   "args": [
    {
     "a.json": {
      "id": "entry-a",
      "date_journal": 1625133600000,
      "timezone": "Europe/Vienna",
      "text": "Walk\n\n![remote](https://example.invalid/a.jpg)",
      "type": "markdown",
      "photos": []
     }
    },
    {},
    [],
    false
   ],
   "expected": {
    "bodies": [
     "Walk"
    ]
   }
  },
  {
   "name": "Unknown timezone falls back to UTC with a warning",
